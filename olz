@bot.tree.command(name="cm", description="Change race mode to solo or duo")
@app_commands.describe(mode="Race mode: solo or duo")
async def change_mode(interaction: discord.Interaction, mode: str):
    async with race_state.lobbies_lock:
        channel_id = interaction.channel.id
        if channel_id not in race_state.race_lobbies:
            await interaction.response.send_message(embed=discord.Embed(
                title="Error", description="No race lobby exists in this channel.", color=0xff0000), ephemeral=True)
            return
        if str(interaction.user.id) != race_state.race_lobbies[channel_id]['host']:
            await interaction.response.send_message(embed=discord.Embed(
                title="Error", description="Only the lobby host can change the mode!", color=0xff0000), ephemeral=True)
            return
        if race_state.active_race == channel_id:
            await interaction.response.send_message(embed=discord.Embed(
                title="Error", description="Cannot change mode during an active race!", color=0xff0000), ephemeral=True)
            return
        if mode.lower() not in ['solo', 'duo']:
            await interaction.response.send_message(embed=discord.Embed(
                title="Error", description="Invalid mode! Use 'solo' or 'duo'.", color=0xff0000), ephemeral=True)
            return
        if mode.lower() == 'duo' and len(race_state.race_lobbies[channel_id]['players']) % 2 != 0:
            await interaction.response.send_message(embed=discord.Embed(
                title="Error", description="Cannot switch to duo mode with an odd number of players!", color=0xff0000), ephemeral=True)
            return
        race_state.race_lobbies[channel_id]['mode'] = mode.lower()
        if mode.lower() == 'duo':
            players_list = list(race_state.race_lobbies[channel_id]['players'])
            random.shuffle(players_list)
            race_state.race_lobbies[channel_id]['teams'] = {}
            for i in range(0, len(players_list), 2):
                team_id = i // 2 + 1
                team = players_list[i:i+2]
                race_state.race_lobbies[channel_id]['teams'][team_id] = team
            logger.info(f"Teams assigned for duo mode: {race_state.race_lobbies[channel_id]['teams']}")
        else:
            race_state.race_lobbies[channel_id]['teams'] = {}
            race_state.race_lobbies[channel_id]['team_names'] = {}
        embed = discord.Embed(title="Race Mode Changed", description=f"Race mode set to **{mode.lower()}**!", color=0x00ff00)
        await interaction.response.send_message(embed=embed)

@bot.tree.command(name="swap", description="Swap two players between teams (host only, duo mode only)")
@app_commands.describe(player1="First player to swap", player2="Second player to swap")
async def swap(interaction: discord.Interaction, player1: discord.User, player2: discord.User):
    async with race_state.lobbies_lock:
        channel_id = interaction.channel.id
        if channel_id not in race_state.race_lobbies:
            await interaction.response.send_message(embed=discord.Embed(
                title="Error", description="No race lobby exists in this channel.", color=0xff0000), ephemeral=True)
            return
        if str(interaction.user.id) != race_state.race_lobbies[channel_id]['host']:
            await interaction.response.send_message(embed=discord.Embed(
                title="Error", description="Only the lobby host can swap players!", color=0xff0000), ephemeral=True)
            return
        if race_state.active_race == channel_id:
            await interaction.response.send_message(embed=discord.Embed(
                title="Error", description="Cannot swap players during an active race!", color=0xff0000), ephemeral=True)
            return
        if race_state.race_lobbies[channel_id]['mode'] != 'duo':
            await interaction.response.send_message(embed=discord.Embed(
                title="Error", description="Swapping is only available in duo mode!", color=0xff0000), ephemeral=True)
            return
        if not race_state.race_lobbies[channel_id]['teams']:
            await interaction.response.send_message(embed=discord.Embed(
                title="Error", description="No teams assigned yet! Use /cm duo to assign teams.", color=0xff0000), ephemeral=True)
            return
        player1_id = str(player1.id)
        player2_id = str(player2.id)
        if player1_id == player2_id:
            await interaction.response.send_message(embed=discord.Embed(
                title="Error", description="Cannot swap a player with themselves!", color=0xff0000), ephemeral=True)
            return
        team1_id = team2_id = None
        for tid, players in race_state.race_lobbies[channel_id]['teams'].items():
            if player1_id in players:
                team1_id = tid
            if player2_id in players:
                team2_id = tid
        if team1_id is None or team2_id is None:
            await interaction.response.send_message(embed=discord.Embed(
                title="Error", description="One or both players are not in any team!", color=0xff0000), ephemeral=True)
            return
        if team1_id == team2_id:
            await interaction.response.send_message(embed=discord.Embed(
                title="Error", description="Players are already in the same team!", color=0xff0000), ephemeral=True)
            return
        race_state.race_lobbies[channel_id]['teams'][team1_id].remove(player1_id)
        race_state.race_lobbies[channel_id]['teams'][team1_id].append(player2_id)
        race_state.race_lobbies[channel_id]['teams'][team2_id].remove(player2_id)
        race_state.race_lobbies[channel_id]['teams'][team2_id].append(player1_id)
        team1_name = race_state.race_lobbies[channel_id]['team_names'].get(team1_id, f'Team {team1_id}')
        team2_name = race_state.race_lobbies[channel_id]['team_names'].get(team2_id, f'Team {team2_id}')
        embed = discord.Embed(
            title="Players Swapped",
            description=f"{player1.mention} (now in {team2_name}) and {player2.mention} (now in {team1_name}) have been swapped!",
            color=0x00ff00)
        await interaction.response.send_message(embed=embed)

