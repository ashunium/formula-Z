# Global state
class RaceState:
    def __init__(self):
        self.race_lobbies: Dict[int, dict] = {}
        self.player_race_data: Dict[str, dict] = {}
        self.lobbies_lock = Lock()
        self.active_race: Optional[int] = None
        self.current_race_players: set = set()
        self.career_stats: Dict[str, dict] = {}
        self.player_control_panels: Dict[str, int] = {}

race_state = RaceState()

def initialize_career_stats(pid: str) -> None:
    race_state.career_stats.setdefault(pid, {})
    defaults = {
        'races_entered': 0, 'wins': 0, 'podiums': 0, 'dnfs': 0, 'fastest_lap': 0, 'points': 0,
        'zcoins': 0, 'last_daily': 0, 'last_weekly': 0, 'last_monthly': 0,
        'driver_cards': [], 'car_cards': [], 'selected_driver': None, 'selected_car': None,
        'silver_packs': 0, 'gold_packs': 0
    }
    save_career_stats()
    for key, value in defaults.items():
        race_state.career_stats[pid].setdefault(key, value)

def load_career_stats() -> None:
    try:
        if os.path.exists("career_stats.json"):
            with open("career_stats.json", "r") as f:
                data = json.load(f)
                for pid in data:
                    if 'silver_packs' in data[pid]:
                        data[pid]['silver_packs'] = data[pid].pop('silver_packs')
                    if 'premium_crates' in data[pid]:
                        data[pid]['gold_packs'] = data[pid].pop('gold_packs')
                race_state.career_stats = data
                for pid in race_state.career_stats:
                    initialize_career_stats(pid)
                logger.info("Loaded career stats from career_stats.json")
        else:
            race_state.career_stats = {}
            logger.info("No career stats file found, starting fresh")
    except Exception as e:
        logger.error(f"Failed to load career stats: {e}")
        race_state.career_stats = {}

def save_career_stats() -> None:
    try:
        with open("career_stats.json", "w") as f:
            json.dump(race_state.career_stats, f, indent=4)
        logger.info("Saved career stats to career_stats.json")
    except Exception as e:
        logger.error(f"Failed to save career stats: {e}")

def generate_card(card_type: str, rarity: str = None) -> Card:
    catalog = CONSTANTS['DRIVER_CARDS'] if card_type == 'driver' else CONSTANTS['CAR_CARDS']
    if rarity:
        available_cards = [(name, data) for name, data in catalog.items() if data['rarity'] == rarity]
    else:
        rarities = list(CONSTANTS['RARITY_WEIGHTS'].keys())
        weights = list(CONSTANTS['RARITY_WEIGHTS'].values())
        selected_rarity = random.choices(rarities, weights)[0]
        available_cards = [(name, data) for name, data in catalog.items() if data['rarity'] == selected_rarity]
    if not available_cards:
        available_cards = [(name, data) for name, data in catalog.items()]
    name, data = random.choice(available_cards)
    attack = max(50, min(100, data['base_attack'] + random.randint(-5, 5)))
    defence = max(50, min(100, data['base_defence'] + random.randint(-5, 5)))
    return Card(
        name=name,
        season=data['season' if card_type == 'driver' else 'year'],
        attack=attack,
        defence=defence,
        rarity=data['rarity'],
        card_id=str(uuid.uuid4())[:8],
        type=card_type
    )

def format_f1_time(seconds: float, mode: str = 'full') -> str:
    if seconds == "DNF":
        return "DNF"
    if mode == 'seconds':
        return f"+{seconds:.3f}" if seconds > 0 else "-"
    hours = int(seconds // 3600)
    minutes = int((seconds % 3600) // 60)
    secs = seconds % 60
    return f"{hours}:{minutes:02d}:{secs:06.3f}"

def generate_weather_schedule(total_laps: int, track: str) -> List[Tuple[int, int, str]]:
    if random.random() < 0.5:
        weather = random.choices(CONSTANTS['WEATHER_TYPES'], CONSTANTS['TRACKS'][track].weather_weights)[0]
        return [(1, total_laps, weather)]
    num_segments = random.randint(2, 3)
    segment_length = total_laps // num_segments
    schedule = []
    last_weather = None
    current_lap = 1
    for i in range(num_segments):
        start_lap = current_lap
        end_lap = min(current_lap + segment_length - 1, total_laps) if i < num_segments - 1 else total_laps
        available_weathers = [w for w in CONSTANTS['WEATHER_TYPES'] if w != last_weather]
        available_weights = CONSTANTS['TRACKS'][track].weather_weights[:len(available_weathers)]
        weather = random.choices(available_weathers, available_weights)[0]
        schedule.append((start_lap, end_lap, weather))
        last_weather = weather
        current_lap = end_lap + 1
    return schedule

async def check_dnf(pid: str, weather: str, track_condition: str) -> bool:
    data = race_state.player_race_data[pid]
    if data['dnf']:
        return False
    stats = race_state.career_stats[pid]
    driver = next((c for c in stats['driver_cards'] if c['card_id'] == stats['selected_driver']), None)
    car = next((c for c in stats['car_cards'] if c['card_id'] == stats['selected_car']), None)
    defence = (driver['defence'] + car['defence']) / 2 if driver and car else 75
    base_dnf_chance = 0.01 * (100 - defence) / 50
    weather_dnf = {'Sunny': 0, 'Cloudy': 0, 'Light Rain': 0.02, 'Heavy Rain': 0.05, 'Foggy': 0.03}
    condition_dnf = {'High Grip': -0.02, 'Low Grip': 0.02, 'Oil Spill': 0.05, 'High Downforce': 0.02}
    dnf_chance = min(base_dnf_chance + weather_dnf[weather] + condition_dnf[track_condition], 0.08)
    if data['current_tyre_wear'] >= 1.0:
        data['dnf'] = True
        data['dnf_reason'] = 'Tyre Wear'
        return True
    elif random.random() < dnf_chance:
        data['dnf'] = True
        data['dnf_reason'] = random.choice(['Mechanical Failure', 'Spin', 'Collision'])
        return True
    return False

class DriverControlPanel(View):
    def __init__(self, player_id: str, channel_id: int):
        super().__init__(timeout=None)
        self.player_id = player_id
        self.channel_id = channel_id

    async def send_or_update_panel(self, user: discord.User, current_lap: int):
        lobby_data = race_state.race_lobbies[self.channel_id]
        track = lobby_data['track']
        total_laps = CONSTANTS['TRACKS'][track].laps
        weather_schedule = lobby_data['weather_schedule']
        current_weather = next((w for s, e, w in weather_schedule if s <= current_lap <= e), "Unknown")
        
        embed = discord.Embed(
            title="🏎️ Driver Control Panel",
            description=f"🏁 **{track}** – Lap {current_lap}/{total_laps}\n"
                        f"**Weather**: {CONSTANTS['WEATHER_EMOJI'][current_weather]} {current_weather}",
            color=0x00ff00
        )
        
        data = race_state.player_race_data.get(self.player_id, {})
        if data.get('dnf'):
            embed.add_field(
                name="Your Status",
                value=f"**DNF** - Reason: {data['dnf_reason']}",
                inline=False
            )
        else:
            # Calculate position, gap to leader, and interval
            standings = [(pid, race_state.player_race_data[pid]['total_time'] if not race_state.player_race_data[pid]['dnf'] else "DNF",
                         race_state.player_race_data[pid]['laps_completed'] if not race_state.player_race_data[pid]['dnf'] else "DNF")
                        for pid in race_state.current_race_players]
            standings.sort(key=lambda x: (x[1] if x[1] != "DNF" else float('inf'), -x[2] if x[2] != "DNF" else -float('inf')))
            position = next((i + 1 for i, (pid, _, _) in enumerate(standings) if pid == self.player_id), "N/A")
            leader_time = next((t for _, t, _ in standings if t != "DNF"), None)
            gap = "-" if position == 1 else format_f1_time(data['total_time'] - leader_time, mode='seconds') if leader_time is not None else "N/A"
            interval = "-"
            if position > 1:
                for i, (pid, t, _) in enumerate(standings):
                    if pid == self.player_id and i > 0:
                        prev_time = standings[i-1][1]
                        if prev_time != "DNF":
                            interval = format_f1_time(data['total_time'] - prev_time, mode='seconds')
            
            wear_percent = min(int(data['current_tyre_wear'] * 100), 100)
            pits = sum(1 for lap in range(1, current_lap + 1) if data.get('last_pit_lap') == lap)
            
            embed.add_field(
                name="Your Status",
                value=(
                    f"**Position**: {position}\n"
                    f"**Gap**: {gap}\n"
                    f"**Interval**: {interval}\n"
                    f"**Tyre**: {CONSTANTS['TYRE_EMOJI'][data['current_tyre']]} {data['current_tyre'].capitalize()}\n"
                    f"**Tyre Wear**: {100 - wear_percent}%\n"
                    f"**Stint**: {data['stint_laps']} laps\n"
                    f"**Pits**: {pits}\n"
                    f"**Strategy**: {data.get('strategy', 'N/A').capitalize()}"
                ),
                inline=True
            )
            embed.add_field(
                name="Tyres Left",
                value=f"{CONSTANTS['TYRE_EMOJI']['soft']}: {data['tyres']['soft']}, "
                      f"{CONSTANTS['TYRE_EMOJI']['medium']}: {data['tyres']['medium']}, "
                      f"{CONSTANTS['TYRE_EMOJI']['hard']}: {data['tyres']['hard']}, "
                      f"{CONSTANTS['TYRE_EMOJI']['intermediate']}: {data['tyres']['intermediate']}, "
                      f"{CONSTANTS['TYRE_EMOJI']['wet']}: {data['tyres']['wet']}",
                inline=True
            )
        
        if self.player_id in race_state.player_control_panels:
            try:
                message = await user.fetch_message(race_state.player_control_panels[self.player_id])
                await message.edit(embed=embed, view=self)
            except (discord.NotFound, discord.Forbidden, discord.HTTPException):
                message = await user.send(embed=embed, view=self)
                race_state.player_control_panels[self.player_id] = message.id
        else:
            message = await user.send(embed=embed, view=self)
            race_state.player_control_panels[self.player_id] = message.id

    @discord.ui.button(label="Box, Box! (Pit)", style=discord.ButtonStyle.red, custom_id="pit_button")
    async def pit_button(self, interaction: Interaction, button: Button):
        if str(interaction.user.id) != self.player_id:
            await interaction.response.send_message("This is not your control panel!", ephemeral=True)
            return
        async with race_state.lobbies_lock:
            if not race_state.active_race or self.channel_id != race_state.active_race:
                await interaction.response.send_message("No active race or wrong channel!", ephemeral=True)
                return
            data = race_state.player_race_data.get(self.player_id)
            if not data or data['dnf']:
                await interaction.response.send_message("You already DNF'd and cannot pit!", ephemeral=True)
                return
            current_weather = None
            current_lap = max(data['laps_completed'], 1)
            for start, end, weather in race_state.race_lobbies[self.channel_id]['weather_schedule']:
                if start <= current_lap <= end:
                    current_weather = weather
                    break
            options = [
                SelectOption(label=tyre.capitalize(), value=tyre, emoji=CONSTANTS['TYRE_EMOJI'][tyre])
                for tyre in CONSTANTS['TYRE_SPEED'].keys()
                if data['tyres'][tyre] > 0 and
                (tyre not in ['intermediate', 'wet'] or current_weather in ['Light Rain', 'Heavy Rain']) and
                (tyre != 'wet' or current_weather == 'Heavy Rain')
            ]
            if not options:
                await interaction.response.send_message("No valid tyres available for current conditions!", ephemeral=True)
                return
            select = discord.ui.Select(placeholder="Select tyre type...", options=options, custom_id="pit_tyre_select")
            async def select_callback(interaction: Interaction):
                tyre_type = interaction.data['values'][0]
                async with race_state.lobbies_lock:
                    base_pit_time = random.uniform(20, 25)
                    weather_pit_modifier = {'Sunny': 0, 'Cloudy': 0, 'Light Rain': 2, 'Heavy Rain': 5, 'Foggy': 1}[current_weather]
                    condition_pit_modifier = {'High Grip': 0, 'Low Grip': 0, 'Oil Spill': 2, 'High Downforce': 0}[
                        race_state.race_lobbies[self.channel_id]['track_condition']
                    ]
                    pit_time = base_pit_time + weather_pit_modifier + condition_pit_modifier
                    old_tyre = data['current_tyre']
                    data['current_tyre'] = tyre_type
                    data['current_tyre_wear'] = 0
                    data['stint_laps'] = 0
                    data['tyres'][tyre_type] -= 1
                    data['total_time'] += pit_time
                    data['last_pit_lap'] = current_lap
                    logger.info(f"User {self.player_id} pitted from {old_tyre} to {tyre_type}, wear reset, +{pit_time:.2f}s")
                    await interaction.response.send_message(
                        f"Box, box! Pitted to {CONSTANTS['TYRE_EMOJI'][tyre_type]} {tyre_type.upper()} tyres! (+{pit_time:.2f}s)",
                        ephemeral=True
                    )
                    await self.send_or_update_panel(interaction.user, current_lap)
            select.callback = select_callback
            view = View()
            view.add_item(select)
            await interaction.response.send_message("Choose your tyre:", view=view, ephemeral=True)

