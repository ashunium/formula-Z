@bot.tree.command(name="settrack", description="Set or change the track for the race lobby (host only).")
@app_commands.describe(track="The track to set for the race")
async def settrack(interaction: discord.Interaction, track: str):
    async with race_state.lobbies_lock:
        channel_id = interaction.channel.id
        if channel_id not in race_state.race_lobbies:
            await interaction.response.send_message("No race lobby exists in this channel.", ephemeral=True)
            return
        if str(interaction.user.id) != race_state.race_lobbies[channel_id]['host']:
            await interaction.response.send_message("Only the lobby host can set the track!", ephemeral=True)
            return
        if race_state.active_race == channel_id:
            await interaction.response.send_message("Cannot change track during an active race!", ephemeral=True)
            return
        if track not in CONSTANTS['TRACKS']:
            await interaction.response.send_message(
                f"Invalid track! Available tracks: {', '.join(CONSTANTS['TRACKS'].keys())}", ephemeral=True
            )
            return
        race_state.race_lobbies[channel_id]['track'] = track
        race_state.race_lobbies[channel_id]['track_condition'] = random.choices(
            CONSTANTS['TRACK_CONDITIONS'], CONSTANTS['TRACKS'][track].condition_weights
        )[0]
        race_state.race_lobbies[channel_id]['weather_schedule'] = generate_weather_schedule(
            CONSTANTS['TRACKS'][track].laps, track
        )
        weather_desc = "\n".join([
            f"{CONSTANTS['WEATHER_EMOJI'][weather]} {weather}: Laps {start}-{end}"
            for start, end, weather in race_state.race_lobbies[channel_id]['weather_schedule']
        ])
        embed = discord.Embed(
            title="Track Updated",
            description=(
                f"🏁 Track set to **{track}** by {interaction.user.mention}\n"
                f"**Track condition**: {race_state.race_lobbies[channel_id]['track_condition']}\n"
                f"**Laps**: {CONSTANTS['TRACKS'][track].laps}\n\n"
                f"**Weather schedule**:\n{weather_desc}"
            ),
            color=0x00ff00
        )
        await interaction.response.send_message(embed=embed)

class LeaderboardSelect(discord.ui.Select):
    def __init__(self):
        options = [
            discord.SelectOption(label="Points", value="points"),
            discord.SelectOption(label="Wins", value="wins"),
            discord.SelectOption(label="Podiums", value="podiums"),
            discord.SelectOption(label="DNFs", value="dnfs"),
            discord.SelectOption(label="Fastest Laps", value="fastest_lap"),
            discord.SelectOption(label="Races Entered", value="races_entered")
        ]
        super().__init__(placeholder="Select a stat to view...", options=options, custom_id="leaderboard_select")

    async def callback(self, interaction: discord.Interaction):
        stat = self.values[0]
        stat_display = {
            'points': 'Points', 'wins': 'Wins', 'podiums': 'Podiums', 'dnfs': 'DNFs',
            'fastest_lap': 'Fastest Laps', 'races_entered': 'Races Entered'
        }[stat]
        players = [
            (pid, stats[stat], stats['selected_driver'], stats['selected_car'])
            for pid, stats in race_state.career_stats.items()
            if not pid.startswith('AI_')
        ]
        players.sort(key=lambda x: x[1], reverse=True)
        description = f"**Leaderboard: {stat_display}**\n\n"
        for i, (pid, value, selected_driver, selected_car) in enumerate(players[:10], 1):
            driver = next((c for c in race_state.career_stats[pid]['driver_cards'] if c['card_id'] == selected_driver), None)
            car = next((c for c in race_state.career_stats[pid]['car_cards'] if c['card_id'] == selected_car), None)
            driver_name = driver['name'] if driver else 'None'
            car_name = car['name'] if car else 'None'
            description += (
                f"**{i}.** <@{pid}> - **{value}** {stat_display}\n"
                f"   Driver: {driver_name} | Car: {car_name}\n"
            )
        if not players:
            description += "No player stats available yet."
        embed = discord.Embed(title="🏆 Formula Z Leaderboard", description=description, color=0x00ff00)
        await interaction.response.edit_message(embed=embed, view=self.view)

@bot.tree.command(name="leaderboard", description="View the leaderboard for player stats.")
