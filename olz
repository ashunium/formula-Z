@bot.tree.command(name="start", description="Start the race for this lobby.")
async def start(interaction: discord.Interaction):
    async with race_state.lobbies_lock:
        channel_id = interaction.channel.id
        logger.info(f"Attempting to start race in channel {channel_id}")
        if channel_id not in race_state.race_lobbies:
            await interaction.response.send_message("No race lobby to start.", ephemeral=True)
            return
        if race_state.active_race:
            await interaction.response.send_message("A race is already in progress!", ephemeral=True)
            return
        if str(interaction.user.id) != race_state.race_lobbies[channel_id]['host']:
            await interaction.response.send_message("Only the lobby host can start the race!", ephemeral=True)
            return
        lobby_players_list = race_state.race_lobbies[channel_id]['players']
        logger.info(f"lobby_players_list type: {type(lobby_players_list)}, value: {lobby_players_list}")
        if not isinstance(lobby_players_list, list):
            logger.error(f"Expected lobby_players_list to be a list, got {type(lobby_players_list)}: {lobby_players_list}")
            await interaction.response.send_message(
                "Internal error: Invalid player list. Please use /yeet to delete the lobby and recreate it with /create.",
                ephemeral=True
            )
            for player in race_state.race_lobbies[channel_id].get('players', []):
                race_state.player_race_data.pop(player, None)
            del race_state.race_lobbies[channel_id]
            return
        if not lobby_players_list:
            await interaction.response.send_message("No players in the lobby!", ephemeral=True)
            return
        for pid in lobby_players_list:
            if not race_state.career_stats[pid]['selected_driver'] or not race_state.career_stats[pid]['selected_car']:
                await interaction.response.send_message(
                    f"Player {'<@' + pid + '>' if not pid.startswith('AI_') else pid[3:]} has not selected a driver or car!",
                    ephemeral=True
                )
                return
        race_state.race_lobbies[channel_id]['podium_rewards'] = len(lobby_players_list) >= 6
        if race_state.race_lobbies[channel_id]['mode'] == 'duo':
            players_list = list(lobby_players_list)
            random.shuffle(players_list)
            race_state.race_lobbies[channel_id]['teams'] = {}
            for i in range(0, len(players_list), 2):
                team_id = i // 2 + 1
                team = players_list[i:i+2]
                if len(team) == 1:
                    ai_name = random.choice([ai for ai in CONSTANTS['AI_PLAYER_NAMES'] if ai not in players_list])
                    team.append(ai_name)
                    race_state.race_lobbies[channel_id]['players'].append(ai_name)
                    race_state.player_race_data[ai_name] = {
                        'tyres': CONSTANTS['DEFAULT_TYRES'].copy(),
                        'initial_tyre': random.choice(['soft', 'medium', 'hard']),
                        'strategy': random.choice(['push', 'balanced', 'save']),
                        'current_tyre': None,
                        'current_tyre_wear': 0,
                        'stint_laps': 0,
                        'laps_completed': 0,
                        'total_time': 0.0,
                        'last_lap_time': 0.0,
                        'dnf': False,
                        'dnf_reason': None,
                        'last_pit_lap': 0
                    }
                    initialize_career_stats(ai_name)
                    driver_card = generate_card('driver')
                    car_card = generate_card('car')
                    race_state.career_stats[ai_name]['driver_cards'].append(driver_card.__dict__)
                    race_state.career_stats[ai_name]['car_cards'].append(car_card.__dict__)
                    race_state.career_stats[ai_name]['selected_driver'] = driver_card.card_id
                    race_state.career_stats[ai_name]['selected_car'] = car_card.card_id
                race_state.race_lobbies[channel_id]['teams'][team_id] = team
            logger.info(f"Teams assigned: {race_state.race_lobbies[channel_id]['teams']}")
        for pid in list(race_state.player_race_data.keys()):
            if pid not in lobby_players_list:
                race_state.player_race_data.pop(pid, None)
        race_state.current_race_players = set(lobby_players_list)
        weather_schedule = race_state.race_lobbies[channel_id]['weather_schedule']
        first_weather = weather_schedule[0][2]
        for pid in lobby_players_list:
            if pid not in race_state.player_race_data:
                race_state.player_race_data[pid] = {
                    'tyres': CONSTANTS['DEFAULT_TYRES'].copy(),
                    'initial_tyre': None,
                    'strategy': None,
                    'current_tyre': None,
                    'current_tyre_wear': 0,
                    'stint_laps': 0,
                    'laps_completed': 0,
                    'total_time': 0.0,
                    'last_lap_time': 0.0,
                    'dnf': False,
                    'dnf_reason': None,
                    'last_pit_lap': 0
                }
            initialize_career_stats(pid)
            race_state.career_stats[pid]['races_entered'] += 1
            if not race_state.player_race_data[pid]['initial_tyre']:
                race_state.player_race_data[pid]['initial_tyre'] = (
                    'intermediate' if first_weather in ['Light Rain', 'Heavy Rain'] else
                    'wet' if first_weather == 'Heavy Rain' else
                    random.choice(['soft', 'medium', 'hard'])
                )
            if not race_state.player_race_data[pid]['strategy']:
                race_state.player_race_data[pid]['strategy'] = 'balanced'
            race_state.player_race_data[pid]['current_tyre'] = race_state.player_race_data[pid]['initial_tyre']
            race_state.player_race_data[pid]['tyres'][race_state.player_race_data[pid]['current_tyre']] -= 1
        save_career_stats()
        logger.info(f"Starting race with players: {lobby_players_list}")
        await interaction.response.send_message("🏁 Race is starting! Simulating laps... Check your DMs for the Driver Control Panel!")
        race_state.active_race = channel_id
    await simulate_race(interaction.channel, lobby_players_list)
    async with race_state.lobbies_lock:
        del race_state.race_lobbies[channel_id]
        save_career_stats()
        race_state.active_race = None
        race_state.current_race_players.clear()

