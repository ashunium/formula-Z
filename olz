    async with race_state.lobbies_lock:
        channel_id = interaction.channel.id
        if channel_id not in race_state.race_lobbies:
            await interaction.response.send_message("No race lobby in this channel.", ephemeral=True)
            return
        if race_state.active_race == channel_id:
            await interaction.response.send_message("Cannot set tyre and strategy during an active race!", ephemeral=True)
            return
