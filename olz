@bot.tree.command(name="openpack", description="Open a silver or gold pack from your inventory.")
@app_commands.describe(pack_type="Choose the pack type to open (silver or gold)")
async def openpack(interaction: discord.Interaction, pack_type: Literal["silver", "gold"]):
    user_id = str(interaction.user.id)
    initialize_career_stats(user_id)
    stats = race_state.career_stats[user_id]

    pack_count_key = f"{pack_type}_packs"
    if stats.get(pack_count_key, 0) < 1:
        await interaction.response.send_message(f"You don't have any {pack_type.capitalize()} Packs to open!", ephemeral=True)
        return

    stats[pack_count_key] -= 1
    rarities = list(CONSTANTS['PACK_CONTENTS'][pack_type].keys())
    weights = list(CONSTANTS['PACK_CONTENTS'][pack_type].values())
    rarity = random.choices(rarities, weights=weights, k=1)[0]
    card_type = random.choice(['driver', 'car'])
    card = generate_card(card_type, rarity)  # Use generate_card for proper stats
    if card_type == 'driver':
        stats['driver_cards'].append(card.__dict__)
    else:
        stats['car_cards'].append(card.__dict__)
    save_career_stats()

    embed = discord.Embed(
        title=f"{pack_type.capitalize()} Pack Opened!",
        description=f"You received: **{card.name} ({card.rarity})** ({card.type.capitalize()} Card, ID: {card.card_id})",
        color=0x00ff00
    )
    embed.add_field(
        name="Remaining Packs",
        value=f"- Silver Packs: {stats.get('silver_packs', 0)}\n- Gold Packs: {stats.get('gold_packs', 0)}",
        inline=False
    )
    await interaction.response.send_message(embed=embed)

async def setup_aiohttp_session():
    resolver = aiohttp.resolver.AsyncResolver()
    resolver.nameservers = ['8.8.8.8', '1.1.1.1']
    connector = aiohttp.TCPConnector(resolver=resolver)
    session = aiohttp.ClientSession(connector=connector)
    return session

async def setup_hook():
    print("Setting up aiohttp session...")
    session = await setup_aiohttp_session()
    bot.http._session = session
    print("aiohttp session set!")

bot.setup_hook = setup_hook
