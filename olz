async def simulate_race(channel: discord.TextChannel, lobby_players_list: List[str]):
    channel_id = channel.id
    track = race_state.race_lobbies[channel_id]['track']
    weather_schedule = race_state.race_lobbies[channel_id]['weather_schedule']
    track_condition = race_state.race_lobbies[channel_id]['track_condition']
    podium_rewards = race_state.race_lobbies[channel_id].get('podium_rewards', False)
    condition_modifiers = {
        'High Grip': {'time': 0.98, 'wear': 0.9},
        'Low Grip': {'time': 1.03, 'wear': 1.05},
        'Oil Spill': {'time': 1.05, 'wear': 1.1},
        'High Downforce': {'time': None, 'wear': 1.05}
    }
    condition_wear_modifier = condition_modifiers[track_condition]['wear']

    lights_message = await channel.send(embed=discord.Embed(title=f"🏎️ {track} Grand Prix - Starting Grid", description="Preparing for lights out...", color=0xff0000))
    await asyncio.sleep(1)
    for light in range(1, 6):
        embed = discord.Embed(title=f"🏎️ {track} Grand Prix - Lights Out", description=f"🔴 " * light + "⚫ " * (5 - light), color=0xff0000)
        await lights_message.edit(embed=embed)
        await asyncio.sleep(1 if light < 5 else 2)  # 1s per light, 2s pause before start
    await lights_message.edit(embed=discord.Embed(title=f"🏎️ {track} Grand Prix - Lights Out", description="⚫ ⚫ ⚫ ⚫ ⚫\n**RACE START!**", color=0x00ff00))

    race_message = await channel.send(embed=discord.Embed(
        title=f"🏎️ Race - {track} ({CONSTANTS['WEATHER_EMOJI'][weather_schedule[0][2]]} {weather_schedule[0][2]}, {track_condition})",
        description="Race starting... Check your DMs for the Driver Control Panel!", color=0x00ff00
    ))
    standings = [(pid, 0.0, 0) for pid in lobby_players_list]
    safety_car = False
    safety_car_laps = 0
    current_weather = weather_schedule[0][2]
    time_modifier = {'Sunny': 1.0, 'Cloudy': 1.02, 'Light Rain': 1.05, 'Heavy Rain': 1.08, 'Foggy': 1.04}[current_weather]
    wear_modifier = {'Sunny': 1.0, 'Cloudy': 1.02, 'Light Rain': 1.05, 'Heavy Rain': 1.08, 'Foggy': 1.04}[current_weather]
    fastest_lap_time = float('inf')
    fastest_lap_player = None

    for pid in lobby_players_list:
        if not pid.startswith('AI_'):
            try:
                user = await bot.fetch_user(int(pid))
                panel = DriverControlPanel(pid, channel_id)
                await panel.send_or_update_panel(user, 1)
            except (discord.NotFound, discord.Forbidden, discord.HTTPException) as e:
                logger.error(f"Failed to send control panel to user ID {pid}: {e}")
                await channel.send(f"⚠️ Failed to send Driver Control Panel to user ID {pid}: {str(e)}")

    for lap in range(1, CONSTANTS['TRACKS'][track].laps + 1):
        for start, end, weather in weather_schedule:
            if start <= lap <= end and weather != current_weather:
                current_weather = weather
                time_modifier = {'Sunny': 1.0, 'Cloudy': 1.02, 'Light Rain': 1.05, 'Heavy Rain': 1.08, 'Foggy': 1.04}[current_weather]
                wear_modifier = {'Sunny': 1.0, 'Cloudy': 1.02, 'Light Rain': 1.05, 'Heavy Rain': 1.08, 'Foggy': 1.04}[current_weather]
                await channel.send(f"Weather change: {CONSTANTS['WEATHER_EMOJI'][current_weather]} {current_weather} starting lap {lap}!")
                for pid in lobby_players_list:
                    if not pid.startswith('AI_'):
                        try:
                            user = await bot.fetch_user(int(pid))
                            panel = DriverControlPanel(pid, channel_id)
                            await panel.send_or_update_panel(user, lap)
                        except (discord.NotFound, discord.Forbidden, discord.HTTPException):
                            continue
                break

        lap_fastest_time = float('inf')
        lap_fastest_player = None
        for i, (pid, _, laps) in enumerate(standings):
            data = race_state.player_race_data.get(pid)
            if not data or pid not in race_state.current_race_players or data['dnf']:
                continue
            dnf_triggered = await check_dnf(pid, current_weather, track_condition)
            if dnf_triggered:
                await channel.send(f"<@{pid}> DNFs due to {data['dnf_reason']}!" if not pid.startswith('AI_') else f"{pid[3:]} DNFs due to {data['dnf_reason']}!")
                race_state.career_stats[pid]['dnfs'] += 1
                if not safety_car:
                    safety_car = True
                    safety_car_laps = 1
                    await channel.send(f"🚨 **Safety Car Deployed for {safety_car_laps} lap!** Incident on track.")
                    time_modifier *= 1.1
                if not pid.startswith('AI_'):
                    try:
                        user = await bot.fetch_user(int(pid))
                        await user.send(embed=discord.Embed(
                            title="🏎️ Your Race Ended!",
                            description=f"✦ Your car suffered a {data['dnf_reason'].lower()} on Lap {lap}. ✦",
                            color=discord.Color.red()
                        ))
                    except (discord.NotFound, discord.Forbidden, discord.HTTPException):
                        logger.warning(f"Failed to send DNF DM to user ID {pid}")
                continue
            if i > 0 and random.random() < 0.02:
                prev_pid, prev_time, _ = standings[i-1]
                if prev_time != "DNF" and data['total_time'] - prev_time < 1.0:
                    time_penalty = random.uniform(2, 5)
                    race_state.player_race_data[pid]['total_time'] += time_penalty
                    race_state.player_race_data[prev_pid]['total_time'] += time_penalty
                    if random.random() < 0.01:
                        race_state.player_race_data[pid]['dnf'] = True
                        race_state.player_race_data[pid]['dnf_reason'] = 'Collision'
                        race_state.career_stats[pid]['dnfs'] += 1
                        await channel.send(f"<@{pid}> DNFs due to collision!" if not pid.startswith('AI_') else f"{pid[3:]} DNFs due to collision!")
                        if not pid.startswith('AI_'):
                            try:
                                user = await bot.fetch_user(int(pid))
                                await user.send(embed=discord.Embed(
                                    title="🏎️ Your Race Ended!",
                                    description=f"✦ Your car suffered a collision on Lap {lap}. ✦",
                                    color=discord.Color.red()
                                ))
                            except (discord.NotFound, discord.Forbidden, discord.HTTPException):
                                logger.warning(f"Failed to send collision DM to user ID {pid}")
                        if not safety_car:
                            safety_car = True
                            safety_car_laps = 1
                            await channel.send(f"🚨 **Safety Car Deployed for {safety_car_laps} lap!** Incident on track.")
                            time_modifier *= 1.1
                    if random.random() < 0.01:
                        race_state.player_race_data[prev_pid]['dnf'] = True
                        race_state.player_race_data[prev_pid]['dnf_reason'] = 'Collision'
                        race_state.career_stats[prev_pid]['dnfs'] += 1
                        await channel.send(f"<@{prev_pid}> DNFs due to collision!" if not prev_pid.startswith('AI_') else f"{prev_pid[3:]} DNFs due to collision!")
                        if not prev_pid.startswith('AI_'):
                            try:
                                user = await bot.fetch_user(int(prev_pid))
                                await user.send(embed=discord.Embed(
                                    title="🏎️ Your Race Ended!",
                                    description=f"✦ Your car suffered a collision on Lap {lap}. ✦",
                                    color=discord.Color.red()
                                ))
                            except (discord.NotFound, discord.Forbidden, discord.HTTPException):
                                logger.warning(f"Failed to send collision DM to user ID {prev_pid}")
                        if not safety_car:
                            safety_car = True
                            safety_car_laps = 1
                            await channel.send(f"🚨 **Safety Car Deployed for {safety_car_laps} lap!** Incident on track.")
                            time_modifier *= 1.1
                    await channel.send(f"Collision! {'<@' + pid + '>' if not pid.startswith('AI_') else pid[3:]} and {'<@' + prev_pid + '>' if not prev_pid.startswith('AI_') else prev_pid[3:]} lose {time_penalty:.2f}s!")
            
            if data['laps_completed'] < lap:
                tyre = data['current_tyre']
                tyre_speed = CONSTANTS['TYRE_SPEED'][tyre]
                if current_weather in ['Light Rain', 'Heavy Rain'] and tyre == 'intermediate':
                    tyre_speed = 0.98
                elif current_weather == 'Heavy Rain' and tyre == 'wet':
                    tyre_speed = 0.97
                condition_time_modifier = condition_modifiers[track_condition]['time'] if condition_modifiers[track_condition]['time'] is not None else (
                    1.02 if data['strategy'] == 'save' and track_condition == 'High Downforce' else 1.0
                )
                stats = race_state.career_stats[pid]
                driver = next((c for c in stats['driver_cards'] if c['card_id'] == stats['selected_driver']), None)
                car = next((c for c in stats['car_cards'] if c['card_id'] == stats['selected_car']), None)
                attack = (driver['attack'] + car['attack']) / 2 if driver and car else 75
                base_time = random.uniform(80, 90) * time_modifier * condition_time_modifier * (0.98 + random.random() * 0.04)
                attack_modifier = (100 - attack) / 100 + 0.5
                lap_time = base_time * tyre_speed * CONSTANTS['STRATEGY_MODIFIER'][data['strategy']] * attack_modifier
                data['total_time'] += lap_time
                data['last_lap_time'] = lap_time
                if lap_time < lap_fastest_time:
                    lap_fastest_time = lap_time
                    lap_fastest_player = pid
                data['laps_completed'] += 1
                just_pitted = data.get('last_pit_lap') == lap
                if not just_pitted:
                    tyre_wear = CONSTANTS['TYRE_WEAR'][tyre] * CONSTANTS['STRATEGY_WEAR'][data['strategy']] * wear_modifier * condition_wear_modifier
                    if current_weather == "Light Rain":
                        if tyre == "intermediate":
                            tyre_wear *= 0.85
                        elif tyre == "wet":
                            tyre_wear *= 1.15
                    elif current_weather == "Heavy Rain":
                        if tyre == "intermediate":
                            tyre_wear *= 1.10
                        elif tyre == "wet":
                            tyre_wear *= 0.75
                    else:
                        if tyre == "wet":
                            tyre_wear *= 1.6
                        elif tyre == "intermediate":
                            tyre_wear *= 1.3
                    data['current_tyre_wear'] = min(data['current_tyre_wear'] + tyre_wear, 1.0)
                else:
                    data['current_tyre_wear'] = 0.0
                    logger.debug(f"🛞 Skipping tyre degradation for {pid} on lap {lap} due to pit stop")
                data['stint_laps'] += 1
                if not pid.startswith('AI_'):
                    try:
                        user = await bot.fetch_user(int(pid))
                        panel = DriverControlPanel(pid, channel_id)
                        await panel.send_or_update_panel(user, lap)
                    except (discord.NotFound, discord.Forbidden, discord.HTTPException):
                        continue

        if lap_fastest_time < fastest_lap_time:
            fastest_lap_time = lap_fastest_time
            fastest_lap_player = lap_fastest_player

        standings = [(pid, race_state.player_race_data[pid]['total_time'] if not race_state.player_race_data[pid]['dnf'] else "DNF",
                     race_state.player_race_data[pid]['laps_completed'] if not race_state.player_race_data[pid]['dnf'] else "DNF")
                    for pid in lobby_players_list]
        standings.sort(key=lambda x: (x[1] if x[1] != "DNF" else float('inf'), -x[2] if x[2] != "DNF" else -float('inf')))
        description = f"""**Weather**: {CONSTANTS['WEATHER_EMOJI'][current_weather]} {current_weather} • Lap: {lap}/{CONSTANTS['TRACKS'][track].laps}
**Safety Car**: {'Active (' + str(safety_car_laps) + ' lap remaining)' if safety_car else 'Inactive'}\n\n"""
        leader_time = None
        prev_time = None
        for i, (pid, time, laps) in enumerate(standings):
            if time == "DNF":
                continue
            if leader_time is None:
                leader_time = time
            gap = "-" if i == 0 else format_f1_time(time - leader_time, mode='seconds')
            interval = "-" if i == 0 else format_f1_time(time - prev_time, mode='seconds') if prev_time is not None else "-"
            tyre = race_state.player_race_data[pid]['current_tyre']
            display_name = pid[3:] if not pid.startswith('AI_') else pid[3:]
            description += f"**P{i+1}** • ``{display_name:<12}`` • ``{gap:>9}`` • ``{interval:>9}`` • {CONSTANTS['TYRE_EMOJI'][tyre]} {race_state.player_race_data[pid]['stint_laps']:02d} ``-``\n"
            prev_time = time
        embed = discord.Embed(title=f"🏎️ **{track}** Grand Prix", description=description, color=0x00ff00)
        await race_message.edit(embed=embed)

        if safety_car:
            safety_car_laps -= 1
            if safety_car_laps <= 0:
                safety_car = False
                time_modifier /= 1.1
                await channel.send("🚦 **Safety Car In!** Racing resumes.")
        await asyncio.sleep(3.5)

    results = [(pid, data['total_time']) for pid, data in race_state.player_race_data.items()
              if pid in race_state.current_race_players and not data['dnf'] and data['laps_completed'] >= CONSTANTS['TRACKS'][track].laps]
    results.sort(key=lambda x: x[1])
    dnfs = [(pid, data['laps_completed'], data['total_time'], data['dnf_reason']) for pid, data in race_state.player_race_data.items()
            if pid in race_state.current_race_players and (data['dnf'] or data['laps_completed'] < CONSTANTS['TRACKS'][track].laps)]
    dnfs.sort(key=lambda x: (-x[1], x[2]))
    async with race_state.lobbies_lock:
        zcoin_rewards = {0: 300, 1: 200, 2: 100} if podium_rewards else {}
        for i, (pid, _) in enumerate(results):
            points = CONSTANTS['F1_POINTS'][i] if i < len(CONSTANTS['F1_POINTS']) else 0
            race_state.career_stats[pid]['points'] += points
            if i == 0:
                race_state.career_stats[pid]['wins'] += 1
            if i < 3:
                race_state.career_stats[pid]['podiums'] += 1
            if i in zcoin_rewards:
                race_state.career_stats[pid]['zcoins'] += zcoin_rewards[i]
            race_state.player_race_data[pid]['position'] = i + 1
        if fastest_lap_player:
            race_state.career_stats[fastest_lap_player]['fastest_lap'] += 1
        description = f"**Weather**: {CONSTANTS['WEATHER_EMOJI'][current_weather]} {current_weather}\n\n"
        if fastest_lap_player:
            display_name = f"<@{fastest_lap_player}>" if not fastest_lap_player.startswith('AI_') else fastest_lap_player[3:]
            description += f"**Fastest Lap**: {display_name} • ``{format_f1_time(fastest_lap_time, mode='full')}``\n\n"
        description += "**Individual Results**\n"
        leader_time = None
        position = 0
        for pid, total_time in results:
            position += 1
            data = race_state.player_race_data[pid]
            points = CONSTANTS['F1_POINTS'][position-1] if position-1 < len(CONSTANTS['F1_POINTS']) else 0
            formatted_time = format_f1_time(total_time, mode='full')
            gap = "-" if leader_time is None else format_f1_time(total_time - leader_time, mode='seconds')
            zcoin_text = f"<:ZCoin:1382982386471669820> +{zcoin_rewards[position-1]}" if position-1 in zcoin_rewards else "-"
            display_name = pid[3:] if not pid.startswith('AI_') else pid[3:]
            description += f"**P{position}** • ``{display_name:<20}`` • ``{formatted_time:<12}`` • ``{gap:<12}`` • {points:<3}Pts • {zcoin_text}\n"
            if leader_time is None:
                leader_time = total_time
        for pid, _, _, dnf_reason in dnfs:
            display_name = f"<@{pid}>" if not pid.startswith('AI_') else pid[3:]
            description += f"• ``{display_name:<20}`` • ``DNF`` • **{dnf_reason:<12}** •\n"
        mode = race_state.race_lobbies[channel_id]['mode']
        if mode == 'duo' and race_state.race_lobbies[channel_id]['teams']:
            description += "\n**Team Results**\n"
            team_points = []
            for team_id, players in race_state.race_lobbies[channel_id]['teams'].items():
                total_points = sum(CONSTANTS['F1_POINTS'][race_state.player_race_data[p]['position']-1] 
                                  if not race_state.player_race_data[p]['dnf'] and 
                                  race_state.player_race_data[p]['laps_completed'] >= CONSTANTS['TRACKS'][track].laps and 
                                  race_state.player_race_data[p]['position']-1 < len(CONSTANTS['F1_POINTS']) else 0 
                                  for p in players)
                team_points.append((team_id, total_points, players))
            team_points.sort(key=lambda x: x[1], reverse=True)
            for team_id, total_points, players in team_points:
                team_name = race_state.race_lobbies[channel_id]['team_names'].get(team_id, f'Team {team_id}')
                display_players = [f"<@{p}>" if not p.startswith('AI_') else p[3:] for p in players]
                description += f"{team_name}: {', '.join(display_players)} • {total_points} points\n"
        save_career_stats()
    embed = discord.Embed(title=f"🏁 Final Results - {track} Grand Prix", description=description, color=0xf1c40f)
    await channel.send(embed=embed)
    race_state.player_control_panels.clear()

